rules_version = '2';
// Paste this whole file into Firebase console → Firestore Database → Rules → Publish
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function hpath(h) { return /databases/$(database)/documents/households/$(h); }
    function memberDoc(h) { return get(/databases/$(database)/documents/households/$(h)/members/$(request.auth.uid)); }
    function isMember(h) { return signedIn() && exists(/databases/$(database)/documents/households/$(h)/members/$(request.auth.uid)); }
    function role(h) { return memberDoc(h).data.role; }
    function isAdmin(h) { return isMember(h) && role(h) == 'admin'; }
    function isOwner(h) { return signedIn() && get(hpath(h)).data.ownerUid == request.auth.uid; }
    function hasRole(h, roles) { return isMember(h) && role(h) in roles; }

    match /households/{h} {
      allow read: if isMember(h);
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isAdmin(h) || (isOwner(h) && request.resource.data.ownerUid == resource.data.ownerUid);

      // PIN hashes: nobody can read them; only admins (or the owner during setup) write them
      match /secret/{d} {
        allow read: if false;
        allow write: if isAdmin(h) || isOwner(h);
      }

      // Joining: the member writes their own doc with the hash of the PIN for a role;
      // the rule compares it with the stored hash, which the client cannot read.
      match /members/{uid} {
        allow read: if isMember(h) || (signedIn() && uid == request.auth.uid);
        allow create: if signedIn() && uid == request.auth.uid
          && request.resource.data.role in ['admin', 'family', 'cook', 'driver']
          && (
            (isOwner(h) && request.resource.data.role == 'admin')
            || (exists(/databases/$(database)/documents/households/$(h)/secret/pins)
                && request.resource.data.pinHash == get(/databases/$(database)/documents/households/$(h)/secret/pins).data.get(request.resource.data.role, 'none'))
          );
        allow update: if signedIn() && uid == request.auth.uid
          && request.resource.data.role == resource.data.role
          && request.resource.data.pinHash == resource.data.pinHash;
        allow delete: if isAdmin(h) || (signedIn() && uid == request.auth.uid);
      }

      match /dishes/{id} { allow read: if isMember(h); allow write: if isAdmin(h); }
      match /items/{id} { allow read: if isMember(h); allow write: if isAdmin(h); }
      match /dishPhotos/{id} { allow read: if isMember(h); allow write: if isAdmin(h); }

      match /menu/{d} {
        allow read: if isMember(h);
        allow create: if hasRole(h, ['admin', 'cook']);
        allow update: if isAdmin(h)
          || (hasRole(h, ['cook']) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seen']));
        allow delete: if isAdmin(h);
      }

      match /shortages/{id} {
        allow read: if hasRole(h, ['admin', 'cook', 'driver']);
        allow create: if hasRole(h, ['admin', 'cook']);
        allow update: if isAdmin(h);
        allow delete: if hasRole(h, ['admin', 'cook', 'driver']);
      }

      match /purchases/{id} {
        allow read: if hasRole(h, ['admin', 'driver']);
        allow create: if hasRole(h, ['admin', 'driver']);
        allow update, delete: if isAdmin(h);
      }

      match /messages/{id} {
        allow read: if isAdmin(h) || (isMember(h) && resource.data.fromUid == request.auth.uid);
        allow create: if isMember(h) && request.resource.data.fromUid == request.auth.uid
          && request.resource.data.from == role(h) && request.resource.data.status == 'new'
          && request.resource.data.text.size() < 2000;
        allow update: if isAdmin(h);
        allow delete: if isAdmin(h) || (isMember(h) && resource.data.fromUid == request.auth.uid);
      }

      match /photoSubmissions/{id} {
        allow create: if hasRole(h, ['admin', 'cook']) && request.resource.data.data.size() < 600000;
        allow read, delete: if isAdmin(h);
      }
    }
  }
}
